## [Keybind]
#----------------------------------------------------------------------
# see all:  ble-bind -P

# bind '"\C-?":kill-backward-cword'
# bind '"\C-H":kill-backward-cword'
# bind '"^H":kill-backward-cword'
# bind '"^[^?":kill-backward-cword'


ble-bind -f 'M-C-?' kill-backward-cword
# ble-bind -k 'ESC DEL' kill-backward-cword

ble-bind -m 'emacs' -f C-BS kill-backward-cword
ble-bind -m 'emacs' -f M-S-DEL kill-backward-cword
ble-bind -m 'emacs' -f M-S-BS kill-backward-cword
ble-bind -m 'emacs' -f C-H kill-backward-cword

# complete'
ble-bind -m 'emacs' -f C-@ menu-complete  # c-space open menu
# ble-bind -m 'emacs' -f RET accept-single-line-or-newline

ble-bind -m 'auto_complete' -f TAB auto_complete/insert  # only insert ghost text
# ble-bind -m 'auto_complete' -f TAB 'auto_complete/@end insert-cword'




