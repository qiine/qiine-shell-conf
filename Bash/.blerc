
# blerc


# see all opt with: blepot

# [Auto menu]
bleopt complete_auto_menu=1
bleopt complete_menu_complete=1
bleopt complete_menu_filter=1

bleopt complete_limit=500
bleopt complete_limit_auto=7
bleopt complete_limit_auto_menu=7
bleopt complete_menu_maxlines=7

bleopt complete_menu_style=desc
# bleopt complete_skip_matched=off


bleopt info_display=top

#Set immediate menu display
#bleopt complete_menu_delay=0


## [Colors]
#----------------------------------------------------------------------
bleopt highlight_syntax=

# bleopt complete_menu_complete=
# bleopt complete_auto_menu=

bleopt complete_menu_color=off
bleopt complete_menu_color_match=off

# custom styles
##################################################################
ble-face auto_complete=fg=blue,bg=none  # ghost text

# ble-face argument_option=fg=black,bg=none  # menu ?
ble-face argument_error=fg=black,bg=none

ble-face disabled=fg=242,bg=none

# ble-face cmdinfo_cd_cdpath=fg=26,bg=none
