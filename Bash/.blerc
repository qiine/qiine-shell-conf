# ble-face command_function=fg=133,bg=none
# ble-face command_jobs=fg=red,bold,bg=none
# ble-face command_keyword=fg=blue,bg=none
ble-face command_suffix=fg=231,bg=none
ble-face command_suffix_new=fg=231,bg=none

